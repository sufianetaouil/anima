// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:9339@localhost:5432/naima_employment"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employer {
  id           String   @id @default(cuid())
  businessName String
  phone        String?
  faxNumber    String?
  cellPhone    String?
  contactName  String?
  address      String?
  city         String?
  state        String?
  zip          String?
  position     String?
  gender      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  jobs         Job[]
}

model Job {
  id            String    @id @default(cuid())
  employer      Employer  @relation(fields: [employerId], references: [id])
  employerId    String
  daysNumber    String?
  daysPerWeek   Int?
  hoursNumber   String?
  pricePerHour  Decimal?
  tips          Boolean?
  paymentMethod String?   // 'cash' or 'check'
  jobType       String?   // 'full' or 'part'
  language      String?   // 'english', 'spanish', or 'both'
  jobStatus     String?   // 'permanent' or 'temporary'
  jobTime       String?   // 'day' or 'night'
  jobDate       DateTime?
  status        String?   // 'available' or 'closed'
  description   String?   // Job description
  requirements  String?   // Job requirements
  benefits      String?   // Job benefits
  location      String?   // Job location
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Employee {
  id                  String    @id @default(cuid())
  memberId           String    @unique // 4 digits + 1 character
  name               String
  dateOfBirth        DateTime?
  status             String?   // 'active' or 'inactive'
  joinDate           DateTime?
  gender             String?
  address            String?
  city               String?
  state              String?
  zip                String?
  phone              String?
  position           String?
  jobType            String?   // 'full' or 'part'
  jobTime            String?   // 'day' or 'night'
  timeDescription    String?
  hispanic           Boolean?
  nationality        String?
  english            Boolean?
  additionalLanguages String?
  ssn                String?
  howLongInUSA       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  refunds            Refund[]
}

model Refund {
  id             String    @id @default(cuid())
  employee       Employee  @relation(fields: [employeeId], references: [id])
  employeeId     String
  refundDate     DateTime
  refundAgent    String?
  paidBefore     Decimal?
  hoursWorking   Decimal?
  salaryPerHour  Decimal?
  commissionRate Decimal?
  lastBalance    Decimal?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
